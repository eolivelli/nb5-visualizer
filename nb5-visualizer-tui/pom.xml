<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.eolivelli</groupId>
    <artifactId>nb5-visualizer-parent</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>nb5-visualizer-tui</artifactId>
  <packaging>jar</packaging>

  <name>NoSQLBench 5 Visualizer :: TUI</name>
  <description>Terminal UI for browsing to metrics directories or zips and rendering the report. Ships as a self-contained jar.</description>

  <dependencies>
    <dependency>
      <groupId>io.github.eolivelli</groupId>
      <artifactId>nb5-visualizer-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.googlecode.lanterna</groupId>
      <artifactId>lanterna</artifactId>
      <version>${lanterna.version}</version>
    </dependency>
    <!-- SSH/SFTP support for remote metrics (the ssh flag). -->
    <dependency>
      <groupId>org.apache.sshd</groupId>
      <artifactId>sshd-core</artifactId>
      <version>${sshd.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.sshd</groupId>
      <artifactId>sshd-sftp</artifactId>
      <version>${sshd.version}</version>
    </dependency>
    <!-- ed25519 keys on JDK < 15; Mina detects this provider by class name,
         so it must never be relocated. -->
    <dependency>
      <groupId>net.i2p.crypto</groupId>
      <artifactId>eddsa</artifactId>
      <version>0.3.0</version>
    </dependency>
    <!-- Mina logs through slf4j; a full-screen TUI must keep the terminal quiet. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Self-contained runnable jar: core + Lanterna shaded in. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.github.eolivelli.nb5visualizer.tui.TuiMain</mainClass>
                </transformer>
                <!-- sshd-common and sshd-sftp both ship a FileSystemProvider
                     services file; they must be merged, not overwritten. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <!-- The eddsa jar is signed; stale signature entries would make
                     the shaded jar refuse to load. -->
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
